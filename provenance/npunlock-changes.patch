+
+void controlled_act(unsigned p) {
+    if (!p) return;
+    MemRef *m = (MemRef*)p;
+    for (unsigned i = 0; i < 3; ++i)
+        if (!m[i].isStatic || !m[i].rank || m[i].rank > 4 || !m[i].dims || !m[i].lo || m[i].hi || m[i].dtype != 1) return;
