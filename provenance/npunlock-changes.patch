+        for (unsigned j = 1; j < width; ++j) {
+            unsigned v = values[row*width+j], a = best & 0x7fffffffu, b = v & 0x7fffffffu;
+            unsigned ka = best & 0x80000000u ? ~best : best ^ 0x80000000u;
