+static inline __attribute__((always_inline)) float flash_add(float a,float b) {
+    unsigned ea=(bits_of(a)>>23)&255u,eb=(bits_of(b)>>23)&255u;
+    return ea>25u||eb>25u?a+b:add32(a,b);
