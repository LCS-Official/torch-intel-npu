@@ -0,0 +1,52 @@
+/* Original row softmax, appended to arithmetic/classification math helpers. */
+void controlled_act(unsigned p) {
+    if (!p) return;
+    MemRef *m = (MemRef*)p;
+    for (unsigned i = 0; i < 3; ++i)
+        if (!m[i].isStatic || m[i].rank != 4 || !m[i].dims || !m[i].lo || m[i].hi || m[i].dtype != 1) return;
+    const unsigned *dims = (const unsigned*)m[0].dims;
+    unsigned width = dims[0], rows = dims[1];
+    if (dims[2] > 1) { width = dims[2]; rows = 1; }
+    if (!width || !rows || rows > 65536u/width) return;
+    const float *a = (const float*)m[0].lo, *b = (const float*)m[1].lo;
+    float *out = (float*)m[2].lo;
+    for (unsigned row = 0; row < rows; ++row) {
+        unsigned base = row*width;
+#if SOFTMAX_BACKWARD
+        float total = 0.0f, correction = 0.0f;
+        for (unsigned j = 0; j < width; ++j) {
+            float v = mul32(a[base+j], b[base+j]), next = add32(total, v);
+            if ((bits_of(total)&0x7fffffffu) < 0x7f800000u && (bits_of(v)&0x7fffffffu) < 0x7f800000u &&
+                (bits_of(next)&0x7fffffffu) < 0x7f800000u)
+                correction = add32(correction, __builtin_fabsf(total) >= __builtin_fabsf(v) ?
+                    add32(add32(total, -next), v) : add32(add32(v, -next), total));
+            else correction = 0.0f;
+            total = next;
+        }
+        total = add32(total, correction);
+        for (unsigned j = 0; j < width; ++j)
+            out[base+j] = mul32(a[base+j], add32(b[base+j], -total));
+#else
+        float maximum = from_bits(0xff800000u);
+        unsigned has_nan = 0;
+        for (unsigned j = 0; j < width; ++j) {
+            float x = a[base+j];
+            if ((bits_of(x)&0x7fffffffu) > 0x7f800000u) has_nan = 1;
+            if (x > maximum) maximum = x;
+        }
+        if (has_nan || (bits_of(maximum)&0x7fffffffu) == 0x7f800000u) {
+            for (unsigned j = 0; j < width; ++j) out[base+j] = from_bits(0x7fc00000u);
+            continue;
+        }
+        float total = 0.0f, correction = 0.0f;
+        for (unsigned j = 0; j < width; ++j) {
+            float v = exp_negative(add32(a[base+j], -maximum)), next = add32(total, v);
+            correction = add32(correction, total >= v ? add32(add32(total, -next), v) : add32(add32(v, -next), total));
+            total = next;
+        }
+        total = add32(total, correction);
+        for (unsigned j = 0; j < width; ++j)
+            out[base+j] = div32(exp_negative(add32(a[base+j], -maximum)), total);
+#endif
+    }
+}
diff --git a/tests/fixtures/npu4000/resident_sort.c b/tests/fixtures/npu4000/resident_sort.c
new file mode 100644
--- /dev/null
+++ b/tests/fixtures/npu4000/resident_sort.c
@@ -0,0 +1,116 @@
+/* Stable floating sort. Indices are raw INT64 words, never floating casts.
+ * Mode 0: bounded bottom-up merge sort, with output-resident scratch.
+ * Mode 1: a tiled bitonic compare/exchange for rows larger than a carrier.
+ */
+static unsigned sort_before(unsigned a, unsigned ai, unsigned b, unsigned bi, unsigned descending) {
+    if (ai == 0xffffffffu || bi == 0xffffffffu) return ai < bi;
+    unsigned aa = a & 0x7fffffffu, bb = b & 0x7fffffffu;
+    unsigned an = aa > 0x7f800000u, bn = bb > 0x7f800000u;
+    if (an != bn) return descending ? an : bn;
+    if (an || (!aa && !bb) || a == b) return ai < bi;
+    unsigned ka = a & 0x80000000u ? ~a : a ^ 0x80000000u;
+    unsigned kb = b & 0x80000000u ? ~b : b ^ 0x80000000u;
+    return descending ? ka > kb : ka < kb;
+}
+
+static unsigned integer_before(const unsigned *a, unsigned ai, const unsigned *b, unsigned bi, unsigned descending) {
+    if (ai == 0xffffffffu || bi == 0xffffffffu) return ai < bi;
+    if (a[0] == b[0] && a[1] == b[1]) return ai < bi;
+    unsigned ah = a[1] ^ 0x80000000u, bh = b[1] ^ 0x80000000u;
+    unsigned less = ah == bh ? a[0] < b[0] : ah < bh;
+    return descending ? !less : less;
+}
+
+void controlled_act(unsigned p) {
+    if (!p) return;
+    MemRef *m = (MemRef*)p;
+    unsigned size = 0;
+    for (unsigned t = 0; t < 3; ++t) {
+        if (!m[t].isStatic || m[t].rank != 4 || !m[t].dims || !m[t].lo || m[t].hi || m[t].dtype != 1) return;
+        unsigned count = 1;
+        const unsigned *dims = (const unsigned*)m[t].dims;
+        for (unsigned a = 0; a < 4; ++a) {
+            if (!dims[a] || dims[a] > 65536u/count) return;
+            count *= dims[a];
+        }
+        if (t && size != count) return;
+        size = count;
+    }
+    unsigned *out = (unsigned*)m[2].lo;
+    for (unsigned i = 0; i < size; ++i) out[i] = 0;
+    if (size < 13) return;
+    const float *h = (const float*)m[0].lo;
+    for (unsigned i = 0; i < 7; ++i)
+        if (!(h[i] >= 0 && h[i] <= 1048576 && (float)(unsigned)h[i] == h[i])) return;
+    unsigned mode = (unsigned)h[0], rows = (unsigned)h[1], width = (unsigned)h[2], desc = (unsigned)h[3];
+    if (mode > 3 || !rows || !width || desc > 1 || rows > (size-7)/width) return;
+    unsigned n = rows*width;
+    const unsigned *in = (const unsigned*)(h+7), *other = (const unsigned*)m[1].lo;
+    if (mode >= 2) {
+        if (mode == 2) {
+            if (n > size/8) return;
+            for (unsigned i=0;i<n;++i) {out[2*i]=in[2*i];out[2*i+1]=in[2*i+1];out[2*n+2*i]=i%width;}
+            for (unsigned row=0;row<rows;++row) {
+                unsigned *src=out,*dst=out+4*n;
+                for (unsigned run=1;run<width;run*=2) {
+                    for (unsigned base=0;base<width;base+=2*run) {
+                        unsigned l=base,mid=base+run<width?base+run:width,r=mid,end=base+2*run<width?base+2*run:width;
+                        for (unsigned q=base;q<end;++q) {
+                            unsigned li=row*width+l,ri=row*width+r;
+                            unsigned take=l<mid && (r==end || integer_before(src+2*li,src[2*n+2*li],src+2*ri,src[2*n+2*ri],desc));
+                            unsigned pos=row*width+(take?l++:r++),target=row*width+q;
+                            dst[2*target]=src[2*pos];dst[2*target+1]=src[2*pos+1];dst[2*n+2*target]=src[2*n+2*pos];dst[2*n+2*target+1]=0;
+                        }
+                    }
+                    unsigned *temp=src;src=dst;dst=temp;
+                }
+                if (src!=out) for (unsigned q=row*width;q<(row+1)*width;++q) {
+                    out[2*q]=src[2*q];out[2*q+1]=src[2*q+1];out[2*n+2*q]=src[2*n+2*q];out[2*n+2*q+1]=0;
+                }
+            }
+        } else {
+            unsigned pos=(unsigned)h[4],stage=(unsigned)h[5],stride=(unsigned)h[6];
+            if (rows!=1 || n>(size-7)/4 || !stage || !stride || stride>=stage || pos+n>524288) return;
+            for (unsigned i=0;i<n;++i) {
+                unsigned ai=in[2*n+2*i],bi=other[2*n+2*i];
+                unsigned first=integer_before(in+2*i,ai,other+2*i,bi,desc);
+                unsigned take=first==((((pos+i)&stage)==0)==(((pos+i)&stride)==0));
+                const unsigned *v=take?in:other;
+                out[2*i]=v[2*i];out[2*i+1]=v[2*i+1];out[2*n+2*i]=take?ai:bi;out[2*n+2*i+1]=0;
+            }
+        }
+        return;
+    }
+    if (!mode) {
+        if (n > size/6) return;
+        for (unsigned i = 0; i < n; ++i) { out[i] = in[i]; out[n+2*i] = i%width; }
+        for (unsigned row = 0; row < rows; ++row) {
+            unsigned *src = out, *dst = out+3*n;
+            for (unsigned run = 1; run < width; run *= 2) {
+                for (unsigned base = 0; base < width; base += 2*run) {
+                    unsigned l = base, mid = base+run < width ? base+run : width, r = mid;
+                    unsigned end = base+2*run < width ? base+2*run : width;
+                    for (unsigned q = base; q < end; ++q) {
+                        unsigned take = l < mid && (r == end || sort_before(src[row*width+l],src[n+2*(row*width+l)],
+                                                                          src[row*width+r],src[n+2*(row*width+r)],desc));
+                        unsigned pos = row*width+(take ? l++ : r++), target = row*width+q;
+                        dst[target] = src[pos]; dst[n+2*target] = src[n+2*pos]; dst[n+2*target+1] = 0;
+                    }
+                }
+                unsigned *temp = src; src = dst; dst = temp;
+            }
+            if (src != out) for (unsigned q = row*width; q < (row+1)*width; ++q) {
+                out[q] = src[q]; out[n+2*q] = src[n+2*q]; out[n+2*q+1] = 0;
+            }
+        }
+    } else {
+        unsigned pos = (unsigned)h[4], stage = (unsigned)h[5], stride = (unsigned)h[6];
+        if (rows != 1 || n > (size-7)/3 || !stage || !stride || stride >= stage || pos+n > 524288) return;
+        for (unsigned i = 0; i < n; ++i) {
+            unsigned a = in[i], ai = in[n+2*i], b = other[i], bi = other[n+2*i];
+            unsigned forward = ((pos+i)&stage) == 0, low = ((pos+i)&stride) == 0;
+            unsigned first = sort_before(a,ai,b,bi,desc), take = first == (forward == low);
+            out[i] = take ? a : b; out[n+2*i] = take ? ai : bi; out[n+2*i+1] = 0;
+        }
+    }
+}
diff --git a/tests/fixtures/npu4000/resident_stream_sum.c b/tests/fixtures/npu4000/resident_stream_sum.c
new file mode 100644
--- /dev/null
+++ b/tests/fixtures/npu4000/resident_stream_sum.c
@@ -0,0 +1,39 @@
+/* Power carrier: state=[sum,correction], rhs=[next values,padding].
+ * Match resident_reduce.c's per-element Neumaier order without a full K stack.
+ * arithmetic.c supplies MemRef and the subnormal-safe FP32 helpers.
+ */
+void controlled_act(unsigned p) {
+    if (!p) return;
+    MemRef *m = (MemRef*)p;
+    unsigned words = 0;
+    for (unsigned t = 0; t < 3; ++t) {
+        if (!m[t].isStatic || !m[t].rank || m[t].rank > 4 || !m[t].dims ||
+            !m[t].lo || m[t].hi || m[t].dtype != 1) return;
+        const unsigned *dims = (const unsigned*)m[t].dims;
+        unsigned n = 1;
+        for (unsigned a = 0; a < m[t].rank; ++a) {
+            if (!dims[a] || dims[a] > 65536u/n) return;
+            n *= dims[a];
+        }
+        if (t && n != words) return;
+        words = n;
+    }
+    if (words < 2 || words % 2) return;
+    unsigned count = words/2;
+    const float *state = (const float*)m[0].lo;
+    const float *values = (const float*)m[1].lo;
+    float *out = (float*)m[2].lo;
+    for (unsigned i = 0; i < count; ++i) {
+        float total = state[i], correction = state[count+i], value = values[i];
+        float next = add32(total, value);
+        if ((bits_of(next) & 0x7f800000u) != 0x7f800000u) {
+            unsigned a = bits_of(total) & 0x7fffffffu;
+            unsigned b = bits_of(value) & 0x7fffffffu;
+            float error = a >= b ? add32(add32(total, -next), value)
+                                : add32(add32(value, -next), total);
+            correction = add32(correction, error);
+        } else correction = 0.0f;
+        out[i] = next;
+        out[count+i] = correction;
+    }
+}
diff --git a/tests/fixtures/npu4000/resident_unary_math.c b/tests/fixtures/npu4000/resident_unary_math.c
new file mode 100644
--- /dev/null
+++ b/tests/fixtures/npu4000/resident_unary_math.c
@@ -0,0 +1,67 @@
+/* Public scalar math; reuses the project's IEEE, exp/log and tanh helpers. */
+static float exp_all(float x) {
+    unsigned u = bits_of(x), magnitude = u & 0x7fffffffu;
+    if (magnitude > 0x7f800000u) return from_bits(u | 0x400000u);
+    if (x > 89.0f) return from_bits(0x7f800000u);
+    if (x < -104.0f) return 0.0f;
+    int k = (int)(x * 1.4426950408889634f + (x < 0.0f ? -0.5f : 0.5f));
+    float r = (x - k * 0.693145751953125f) - k * 0.000001428606765330187f;
+    float p = 1.0f/40320.0f;
+    p = 1.0f/5040.0f + r*p;
+    p = 1.0f/720.0f + r*p;
+    p = 1.0f/120.0f + r*p;
+    p = 1.0f/24.0f + r*p;
+    p = 1.0f/6.0f + r*p;
+    p = 0.5f + r*p;
+    p = 1.0f + r*p;
+    p = 1.0f + r*p;
+    unsigned bits = bits_of(p);
+    return encode64((bits & 0x7fffffu) | 0x800000u, k + (int)(bits >> 23) - 150, 0);
+}
+
+static float log_all(float x) {
+    unsigned u = bits_of(x), magnitude = u & 0x7fffffffu;
